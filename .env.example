# Open-Meteo commercial account key. Required for commercial use of reserved resources.
# The app can run development searches against the public endpoint, but do not launch commercially without the appropriate license/key.
OPEN_METEO_API_KEY=

# OpenFreeMap is used by default for the basemap. No key is required.
# Replace this with a commercial MapTiler/custom style URL if your deployment requires it.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Optional AI explanation provider. The application remains functional without AI.
AI_API_KEY=
AI_API_BASE_URL=
AI_MODEL=

# Public site URL used for metadata and canonical URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NWS identification. NWS requires a descriptive User-Agent header.
NWS_USER_AGENT=Snow Trail/0.1 (contact@example.com)
